{
    "name": "windy-plugin-horizon-distance",
    "version": "0.9.6",
    "description": "Windy plugin: horizon distance rings for low, mid and high clouds at sunrise and sunset",
    "main": "dist/plugin.min.js",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && mkdir dist && SERVE=false rollup -c && cp package.json dist/",
        "start": "rollup -w -c",
        "example01": "CONFIG=example01 rollup -w -c",
        "example02": "CONFIG=example02 rollup -w -c",
        "example03": "CONFIG=example03 rollup -w -c",
        "example04": "CONFIG=example04 rollup -w -c",
        "example05": "CONFIG=example05 rollup -w -c",
        "example06": "CONFIG=example06 rollup -w -c",
        "example07": "CONFIG=example07 rollup -w -c",
        "build:all-examples": "for number in 01 02 03 04 05 06; do CONFIG=example$number SERVE=false rollup -c; done",
        "test": "node --experimental-strip-types --no-warnings src/geo.test.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chiotas/clouds-horizon-distance.git"
    },
    "keywords": [
        "windy",
        "windy.com",
        "plugins"
    ],
    "author": "Francesco Gola",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/chiotas/clouds-horizon-distance/issues"
    },
    "homepage": "https://docs.windy-plugins.com/",
    "dependencies": {
        "@windycom/plugin-devtools": "^3.0.3",
        "suncalc": "^1.9.0"
    }
}
